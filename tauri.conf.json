{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage Monitor",
  "mainBinaryName": "usage-monitor",
  "identifier": "io.github.tiennm99.usagemonitor",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage",
      "deb"
    ],
    "createUpdaterArtifacts": false,
    "copyright": "Copyright (C) 2026 tiennm99",
    "publisher": "tiennm99",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/tiennm99/usage-monitor/releases/latest/download/latest.json"
      ]
    }
  }
}
